# YUNITE Enterprise Operating System - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL connection string (via Supabase)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0.region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-0.region.pooler.supabase.com:5432/postgres

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER expose this - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT Secret for token verification
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Supabase Access Token (for admin operations)
SUPABASE_ACCESS_TOKEN=sbp_your-access-token

# ===========================================
# REDIS CONFIGURATION
# ===========================================

# Redis connection URL — used by the API gateway rate limiter as a shared
# store so limits hold across serverless instances (Vercel). Any
# ioredis-compatible URL works (e.g. an Upstash rediss:// URL). When unset,
# the limiter falls back to an in-memory store (fine for single-instance
# Render / local dev).
REDIS_URL=redis://default:your-redis-password@your-redis-host:your-redis-port

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# PRIMARY: Gmail API (OAuth2) - Recommended for Render Free tier
# This method uses HTTPS instead of SMTP and avoids port blocking
# To set up:
# 1. Create a Google Cloud project at https://console.cloud.google.com
# 2. Enable the Gmail API
# 3. Create OAuth2 credentials (Web application)
# 4. Generate a refresh token using the OAuth2 flow
#    (See: https://developers.google.com/gmail/api/auth/web-server)
# IMPORTANT: Never commit actual credentials to GitHub
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_SENDER_EMAIL=your_sender_email@gmail.com
GOOGLE_SENDER_NAME=YUNITE

# FALLBACK: SMTP (use only if Gmail API is not configured)
# Note: Render Free tier blocks outbound SMTP on port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=false

# ===========================================
# RATE LIMITING
# ===========================================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================

# Directory for temporary uploads
UPLOAD_DIR=./uploads

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Public URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application name
NEXT_PUBLIC_APP_NAME=YUNITE Enterprise OS

# Environment
NODE_ENV=development

# ===========================================
# ENVIRONMENT-SPECIFIC SETTINGS
# ===========================================

# Super Admin bootstrap (create via environment for initial setup)
# Only used during first deployment if no super admin exists
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_PHONE=+254700000000
SUPER_ADMIN_STATUS=ACTIVE

# ===========================================
# AI INTELLIGENCE ENGINE
# ===========================================
# Provider keys are SERVER-SIDE ONLY — never prefixed with NEXT_PUBLIC_.
# If a key is unset, that provider is "not configured" and the engine falls
# back to the other provider, then to deterministic-only analysis.
AI_PROVIDER=gemini
AI_DUAL_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Failfast probe timeout (ms) for provider failure detection. Does NOT cap
# generation duration — only how long we wait before falling over.
AI_FAILFAST_TIMEOUT_MS=1000
# Optional: member-lookup BFF base URL for display-layer verification.
# Unset → member verification falls back to DB-vs-API comparison.
MEMBER_LOOKUP_VERIFY_URL=
MEMBER_LOOKUP_VERIFY_SECRET=
# Shared secret for /api/cron/ai-investigations (must match cron service).
# Generate with: openssl rand -hex 32
CRON_SECRET=
