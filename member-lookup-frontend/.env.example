# YUNITE PAMOJA CBO — Member Lookup Portal environment configuration.
#
# Copy to `.env.local` for local development. In production, set these as
# Vercel Environment Variables (Settings → Environment Variables). Never
# commit real secret values to version control.

# Base URL of the existing YUNITE CBO backend API (source of truth).
# Do NOT include a trailing slash.
YUNITE_API_BASE_URL=https://yunite-cbo-portal.onrender.com

# A live YUNITE API key with read access to member/financial endpoints.
# NEVER expose this to the browser — it is used ONLY by server-side routes.
# Supplied through the Vercel deployment environment.
YUNITE_API_KEY=yk_live_replace_with_real_key

# Secret used to sign short-lived member session JWTs (httpOnly cookies).
# Generate with: openssl rand -hex 32
MEMBER_SESSION_SECRET=replace_with_long_random_secret

# Session lifetime in seconds (default: 30 minutes — short-lived by design).
MEMBER_SESSION_TTL_SECONDS=1800

# Public base URL of THIS portal (used for metadata/SEO). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
