model UnityFund {
  id                    String   @id @default(uuid())
  organizationId        String   @unique @map("organization_id")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  availableCash         Decimal  @default(0) @db.Decimal(19, 4) @map("available_cash")
  totalIncome           Decimal  @default(0) @db.Decimal(19, 4) @map("total_income")
  totalExpenses         Decimal  @default(0) @db.Decimal(19, 4) @map("total_expenses")
  outstandingFines      Decimal  @default(0) @db.Decimal(19, 4) @map("outstanding_fines")
  outstandingWelfare    Decimal  @default(0) @db.Decimal(19, 4) @map("outstanding_welfare")
  expectedReceivables   Decimal  @default(0) @db.Decimal(19, 4) @map("expected_receivables")
  totalDonations        Decimal  @default(0) @db.Decimal(19, 4) @map("total_donations")
  totalFundraisers      Decimal  @default(0) @db.Decimal(19, 4) @map("total_fundraisers")
  totalGrants           Decimal  @default(0) @db.Decimal(19, 4) @map("total_grants")
  totalSponsorships     Decimal  @default(0) @db.Decimal(19, 4) @map("total_sponsorships")
  lastTransactionAt     DateTime? @map("last_transaction_at")
  lastAuditAt           DateTime? @map("last_audit_at")

  transactions          UnityFundTransaction[]
  withdrawals           UnityFundWithdrawal[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("unity_funds")
}

model UnityFundTransaction {
  id            String   @id @default(uuid())
  unityFundId   String   @map("unity_fund_id")
  unityFund     UnityFund @relation(fields: [unityFundId], references: [id], onDelete: Cascade)
  type          String   // INCOME, EXPENSE, TRANSFER
  category      String
  amount        Decimal  @db.Decimal(19, 4)
  description   String?
  reference     String?
  sourceType    String?
  sourceId      String?  @map("source_id")
  journalEntryId String? @map("journal_entry_id")
  transactionId String?  @map("transaction_id")
  status        String   @default("COMPLETED")
  createdById   String?  @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([unityFundId])
  @@index([type])
  @@index([createdAt])
  @@map("unity_fund_transactions")
}

model UnityFundWithdrawal {
  id              String   @id @default(uuid())
  unityFundId     String   @map("unity_fund_id")
  unityFund       UnityFund @relation(fields: [unityFundId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(19, 4)
  purpose         String
  allocationId    String   @map("allocation_id")
  allocation      UnityFundAllocation @relation(fields: [allocationId], references: [id])
  beneficiary     String?
  beneficiaryDetails Json? @map("beneficiary_details")
  referenceNumber String   @unique @map("reference_number")
  notes           String?
  documents       String[]
  status          String   @default("PENDING")
  approvedById    String?  @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?  @map("rejection_reason")
  journalEntryId  String?  @map("journal_entry_id")
  transactionId   String?  @map("transaction_id")
  createdById     String   @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unityFundId])
  @@index([status])
  @@index([allocationId])
  @@map("unity_fund_withdrawals")
}

model UnityFundAllocation {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  description     String?
  category        String
  budgetedAmount  Decimal  @default(0) @db.Decimal(19, 4) @map("budgeted_amount")
  spentAmount     Decimal  @default(0) @db.Decimal(19, 4) @map("spent_amount")
  remainingBudget Decimal  @default(0) @db.Decimal(19, 4) @map("remaining_budget")
  organizationId  String   @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive        Boolean  @default(true) @map("is_active")
  isSystem        Boolean  @default(false) @map("is_system")

  withdrawals     UnityFundWithdrawal[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("unity_fund_allocations")
}

