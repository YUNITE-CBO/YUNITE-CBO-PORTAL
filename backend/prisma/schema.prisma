  agenda         String?
  minutes        String?
  status         String       @default("SCHEDULED")
  meetingLink    String?      @map("meeting_link")

  attendees      MeetingAttendee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([scheduledDate])
  @@map("meetings")
}

model MeetingAttendee {
  id          String     @id @default(uuid())
  meetingId   String     @map("meeting_id")
  meeting     Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId    String     @map("member_id")
  member      Member     @relation(fields: [memberId], references: [id])
  status      String     @default("PENDING")
  checkInTime DateTime?  @map("check_in_time")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([meetingId, memberId])
  @@index([meetingId])
  @@map("meeting_attendees")
}

// ============================================
// VOTING
// ============================================

model Poll {
  id             String      @id @default(uuid())
  title          String
  description    String?
  organizationId String      @map("organization_id")
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  status         PollStatus  @default(DRAFT)
  allowMultiple  Boolean     @default(false) @map("allow_multiple")
  showResults    Boolean     @default(false) @map("show_results")
  isAnonymous    Boolean     @default(false) @map("is_anonymous")

  options        PollOption[]
  votes          PollVote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("polls")
}

model PollOption {
  id       String     @id @default(uuid())
  pollId   String     @map("poll_id")
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   String
  votes    PollVote[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String     @map("poll_id")
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String     @map("option_id")
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  memberId  String     @map("member_id")
  member    Member     @relation(fields: [memberId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pollId, memberId, optionId])
  @@index([pollId])
  @@index([optionId])
  @@index([memberId])
  @@map("poll_votes")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean  @default(false) @map("is_read")
  data      Json?
  readAt    DateTime? @map("read_at")
  actionUrl String?  @map("action_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// DOCUMENTS
// ============================================

model Document {
  id         String   @id @default(uuid())
  name       String
  type       String
  mimeType   String   @map("mime_type")
  size       Int
  url        String
  memberId   String?  @map("member_id")
  member     Member?  @relation(fields: [memberId], references: [id])
  uploadedById String? @map("uploaded_by_id")
  uploadedBy User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  folder     String?
  tags       String[]
  description String?
  isPublic   Boolean  @default(false) @map("is_public")
  deletedAt  DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([type])
  @@index([folder])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("documents")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  deviceInfo Json?    @map("device_info")
  location   String?
  module     String?
  organizationId String? @map("organization_id")
  branchId   String?  @map("branch_id")
  duration   Int?     // Execution time in ms

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@index([organizationId])
  @@map("audit_logs")
}

// ============================================
// APPROVALS & WORKFLOW
// ============================================

model Approval {
  id            String   @id @default(uuid())
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  status        ApprovalStatus @default(PENDING)
  requestedById String   @map("requested_by_id")
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  approvedById  String?  @map("approved_by_id")
  approvedBy    User?    @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime? @map("approved_at")
  rejectionReason String? @map("rejection_reason")
  comments      String?
  level         Int      @default(1)
  maxLevel      Int      @default(1)
  organizationId String  @map("organization_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([status])
  @@index([requestedById])
  @@index([organizationId])
  @@map("approvals")
}

model WorkflowAction {
  id            String   @id @default(uuid())
  workflowName  String   @map("workflow_name")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  fromStatus    String   @map("from_status")
  toStatus      String   @map("to_status")
  performedById String   @map("performed_by_id")
  performedBy   User     @relation(fields: [performedById], references: [id])
  comments      String?
  metadata      Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([performedById])
  @@map("workflow_actions")
}

// ============================================
// MESSAGING & COMMUNICATION
// ============================================

model Message {
  id          String   @id @default(uuid())
  subject     String
  body        String
  senderId    String   @map("sender_id")
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String   @map("recipient_id")
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  memberId    String?  @map("member_id")
  member      Member?  @relation("MessageMember", fields: [memberId], references: [id])
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  parentId    String?  @map("parent_id")
  attachments String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([senderId])
  @@index([recipientId])
  @@index([memberId])
  @@index([isRead])
  @@map("messages")
}

// ============================================
// EVENTS & TASKS
// ============================================

model Event {
  id             String       @id @default(uuid())
  title          String
  description    String?
  startDate      DateTime     @map("start_date")
  endDate        DateTime?    @map("end_date")
  location       String?
  isAllDay       Boolean      @default(false) @map("is_all_day")
  color          String?      @default("#3B82F6")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String       @map("created_by_id")
  createdBy      User         @relation("EventCreatedBy", fields: [createdById], references: [id])
  isPublic       Boolean      @default(true) @map("is_public")
  status         String       @default("SCHEDULED")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([startDate])
  @@map("events")
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         String       @default("PENDING")
  priority       String       @default("MEDIUM")
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedToId   String?      @map("assigned_to_id")
  assignedTo     User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById    String       @map("created_by_id")
  createdBy      User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  relatedType    String?      @map("related_type")
  relatedId      String?      @map("related_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  id             String @id @default(uuid())
  key            String @unique
  value          Json
  type           String @default("string") @map("value_type")
  group          String @default("general")
  category       String @default("general")
  isPublic       Boolean @default(false) @map("is_public")
  isSystem       Boolean @default(false) @map("is_system")
  organizationId String? @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description    String?
  allowedValues  Json?   @map("allowed_values")
  defaultValue   Json?   @map("default_value")
  minValue       Float?  @map("min_value")
  maxValue       Float?  @map("max_value")
  pattern        String? @map("pattern")
  createdById    String? @map("created_by_id")
  createdBy      User?   @relation("SettingCreatedBy", fields: [createdById], references: [id])
  updatedById    String? @map("updated_by_id")
  updatedBy      User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([group])
  @@index([organizationId])
  @@map("settings")
}

// ============================================
// HELP DESK
// ============================================

model HelpDeskTicket {
  id             String       @id @default(uuid())
  ticketNumber   String       @unique @map("ticket_number")
  subject        String
  description    String
  status         String       @default("OPEN")
  priority       String       @default("MEDIUM")
  category       String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String       @map("created_by_id")
  createdBy      User         @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId   String?      @map("assigned_to_id")
  assignedTo     User?        @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  memberId       String?      @map("member_id")
  member         Member?      @relation("TicketMember", fields: [memberId], references: [id])
  resolvedAt     DateTime?    @map("resolved_at")
  resolution     String?

  responses      HelpDeskResponse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@index([assignedToId])
  @@index([createdById])
  @@map("help_desk_tickets")
}

model HelpDeskResponse {
  id         String         @id @default(uuid())
  ticketId   String         @map("ticket_id")
  ticket     HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String         @map("user_id")
  message    String
  attachments String[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("help_desk_responses")
}

// ============================================
// CONTRACTS
// ============================================

model Contract {
  id             String       @id @default(uuid())
  contractNumber String       @unique @map("contract_number")
  title          String
  description    String?
  type           String       // MEMBERSHIP, LOAN, SERVICE, SUPPLIER, EMPLOYMENT
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partyId        String?      @map("party_id")
  partyName      String?
  startDate      DateTime     @map("start_date")
  endDate        DateTime?    @map("end_date")
  value          Decimal?     @db.Decimal(19, 4)
  status         String       @default("DRAFT")
  terms          String?
  createdById    String       @map("created_by_id")
  createdBy      User         @relation("ContractCreatedBy", fields: [createdById], references: [id])
  approvedById   String?      @map("approved_by_id")
  approvedAt     DateTime?    @map("approved_at")
  documentUrl    String?      @map("document_url")
  deletedAt      DateTime?    @map("deleted_at")

  payments       ContractPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("contracts")
}

model ContractPayment {
  id            String     @id @default(uuid())
  contractId    String     @map("contract_id")
  contract      Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount        Decimal    @db.Decimal(19, 4)
  dueDate       DateTime   @map("due_date")
  paidDate      DateTime?  @map("paid_date")
  status        String     @default("PENDING")
  transactionId String?    @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@map("contract_payments")
}

// ============================================
// SUPPLIERS & VENDORS
// ============================================

model Supplier {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  contactPerson  String?      @map("contact_person")
  email          String?
  phone          String?
  address        String?
  taxPin         String?      @map("tax_pin")
  paymentTerms   String?      @map("payment_terms")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("suppliers")
}

model Vendor {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  contactPerson  String?      @map("contact_person")
  email          String?
  phone          String?
  address        String?
  serviceType    String?      @map("service_type")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("vendors")
}

model Customer {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  email          String?
  phone          String?
  address        String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("customers")
}

// ============================================
// INVENTORY & ASSETS
// ============================================

model InventoryItem {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  category       String?
  unit           String?
  quantity       Int          @default(0)
  reorderLevel   Int          @default(0) @map("reorder_level")
  unitCost       Decimal      @default(0) @db.Decimal(19, 4) @map("unit_cost")
  totalValue     Decimal      @default(0) @db.Decimal(19, 4) @map("total_value")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  transactions   InventoryTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String         @id @default(uuid())
  itemId          String         @map("item_id")
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type            String         // RECEIPT, ISSUE, TRANSFER, ADJUSTMENT
  quantity        Int
  unitCost        Decimal        @db.Decimal(19, 4) @map("unit_cost")
  totalAmount     Decimal        @db.Decimal(19, 4) @map("total_amount")
  reference       String?
  description     String?
  transactionId   String?        @map("transaction_id")
  transaction     Transaction?   @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId])
  @@index([type])
  @@map("inventory_transactions")
}

model Asset {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  category       String?
  purchaseDate   DateTime     @map("purchase_date")
  purchaseCost   Decimal      @db.Decimal(19, 4) @map("purchase_cost")
  currentValue   Decimal      @db.Decimal(19, 4) @map("current_value")
  depreciationRate Decimal?   @db.Decimal(5, 2) @map("depreciation_rate")
  location       String?
  status         String       @default("ACTIVE")
  assignedTo     String?      @map("assigned_to")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedAt      DateTime?    @map("deleted_at")

  transactions   AssetTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("assets")
}

model AssetTransaction {
  id            String     @id @default(uuid())
  assetId       String     @map("asset_id")
  asset         Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type          String     // ACQUISITION, DEPRECIATION, DISPOSAL, TRANSFER, MAINTENANCE
  amount        Decimal    @db.Decimal(19, 4)
  description   String?
  date          DateTime   @default(now())
  transactionId String?    @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@map("asset_transactions")
}

// ============================================
// BUDGETING
// ============================================

model BudgetPeriod {
  id             String       @id @default(uuid())
  name           String
  fiscalYear     Int          @map("fiscal_year")
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  status         String       @default("DRAFT")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  budgetLines    BudgetLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("budget_periods")
}

model BudgetLine {
  id            String       @id @default(uuid())
  budgetPeriodId String      @map("budget_period_id")
  budgetPeriod  BudgetPeriod @relation(fields: [budgetPeriodId], references: [id], onDelete: Cascade)
  accountId     String       @map("account_id")
  account       Account      @relation(fields: [accountId], references: [id])
  budgetedAmount Decimal     @db.Decimal(19, 4) @map("budgeted_amount")
  actualAmount  Decimal      @default(0) @db.Decimal(19, 4) @map("actual_amount")
  variance      Decimal      @default(0) @db.Decimal(19, 4)

  transactions  BudgetTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([budgetPeriodId, accountId])
  @@index([budgetPeriodId])
  @@index([accountId])
  @@map("budget_lines")
}

model BudgetTransaction {
  id            String        @id @default(uuid())
  budgetLineId  String        @map("budget_line_id")
  budgetLine    BudgetLine    @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(19, 4)
  description   String?
  date          DateTime      @default(now())
  transactionId String?       @map("transaction_id")
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([budgetLineId])
  @@map("budget_transactions")
}

// ============================================
// PROCUREMENT
// ============================================

model ProcurementRequest {
  id             String       @id @default(uuid())
  requestNumber  String       @unique @map("request_number")
  title          String
  description    String?
  amount         Decimal      @db.Decimal(19, 4)
  status         String       @default("DRAFT")
  priority       String       @default("MEDIUM")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String       @map("requested_by_id")
  approvedById   String?      @map("approved_by_id")
  approvedAt     DateTime?    @map("approved_at")
  supplierId     String?      @map("supplier_id")

  payments       ProcurementPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("procurement_requests")
}

model ProcurementPayment {
  id                 String              @id @default(uuid())
  procurementRequestId String            @map("procurement_request_id")
  procurementRequest ProcurementRequest  @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  amount             Decimal             @db.Decimal(19, 4)
  paymentDate        DateTime            @default(now()) @map("payment_date")
  paymentMethod      PaymentMethod?
  reference          String?
  transactionId      String?             @map("transaction_id")
  transaction        Transaction?        @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([procurementRequestId])
  @@map("procurement_payments")
}

// ============================================
// PAYROLL & HR
// ============================================

model Employee {
  id            String       @id @default(uuid())
  employeeNumber String      @unique @map("employee_number")
  memberId      String?      @map("member_id")
  member        Member?      @relation(fields: [memberId], references: [id])
  departmentId  String?      @map("department_id")
  department    Department?  @relation(fields: [departmentId], references: [id])
  jobTitle      String?      @map("job_title")
  employmentDate DateTime    @map("employment_date")
  terminationDate DateTime?  @map("termination_date")
  status        String       @default("ACTIVE")
  salary        Decimal      @default(0) @db.Decimal(19, 4)
  bankAccount   String?      @map("bank_account")
  bankName      String?      @map("bank_name")
  taxPin        String?      @map("tax_pin")
  nssfNumber    String?      @map("nssf_number")
  nhifNumber    String?      @map("nhif_number")

  payrollItems  PayrollItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

model PayrollRun {
  id             String       @id @default(uuid())
  runNumber      String       @unique @map("run_number")
  period         String       // e.g., "2024-01"
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  paymentDate    DateTime     @map("payment_date")
  totalGross     Decimal      @default(0) @db.Decimal(19, 4) @map("total_gross")
  totalDeductions Decimal     @default(0) @db.Decimal(19, 4) @map("total_deductions")
  totalNet       Decimal      @default(0) @db.Decimal(19, 4) @map("total_net")
  status         String       @default("DRAFT")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processedById  String?      @map("processed_by_id")
  processedBy    User?        @relation("PayrollProcessedBy", fields: [processedById], references: [id])
  approvedById   String?      @map("approved_by_id")
  approvedAt     DateTime?    @map("approved_at")

  items          PayrollItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("payroll_runs")
}

model PayrollItem {
  id            String      @id @default(uuid())
  payrollRunId  String      @map("payroll_run_id")
  payrollRun    PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String      @map("employee_id")
  employee      Employee    @relation(fields: [employeeId], references: [id])
  memberId      String?     @map("member_id")
  member        Member?     @relation(fields: [memberId], references: [id])
  basicPay      Decimal     @db.Decimal(19, 4) @map("basic_pay")
  allowances    Json?       @default("{}")
  deductions    Json?       @default("{}")
  grossPay      Decimal     @db.Decimal(19, 4) @map("gross_pay")
  totalDeductions Decimal   @db.Decimal(19, 4) @map("total_deductions")
  netPay        Decimal     @db.Decimal(19, 4) @map("net_pay")
  bankAccount   String?     @map("bank_account")
  status        String      @default("PENDING")
  transactionId String?     @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([memberId])
  @@map("payroll_items")
}

// ============================================
// BENEFICIARIES
// ============================================

model Beneficiary {
  id             String       @id @default(uuid())
  name           String
  relationship   String?
  phone          String?
  email          String?
  address        String?
  idNumber       String?      @map("id_number")
  memberId       String       @map("member_id")
  member         Member       @relation("BeneficiaryMember", fields: [memberId], references: [id])
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")
  allocation     Decimal?     @default(0) @db.Decimal(5, 2) // Percentage allocation

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([organizationId])
  @@map("beneficiaries")
}

// ============================================
// INSURANCE
// ============================================

model InsuranceScheme {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  premiumAmount  Decimal      @db.Decimal(19, 4) @map("premium_amount")
  coverageAmount Decimal      @db.Decimal(19, 4) @map("coverage_amount")
  frequency      Frequency    @default(MONTHLY)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  policies       InsurancePolicy[]
  claims         InsuranceClaim[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("insurance_schemes")
}

model InsurancePolicy {
  id             String          @id @default(uuid())
  policyNumber   String          @unique @map("policy_number")
  schemeId       String          @map("scheme_id")
  scheme         InsuranceScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  memberId       String          @map("member_id")
  member         Member          @relation(fields: [memberId], references: [id])
  startDate      DateTime        @map("start_date")
  endDate        DateTime        @map("end_date")
  premiumAmount  Decimal         @db.Decimal(19, 4) @map("premium_amount")
  coverageAmount Decimal         @db.Decimal(19, 4) @map("coverage_amount")
  status         String          @default("ACTIVE")

  premiums       InsurancePremium[]
  claims         InsuranceClaim[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([schemeId])
  @@index([memberId])
  @@map("insurance_policies")
}

model InsurancePremium {
  id            String          @id @default(uuid())
  policyId      String          @map("policy_id")
  policy        InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  amount        Decimal         @db.Decimal(19, 4)
  period        String
  paidDate      DateTime        @map("paid_date")
  status        String          @default("PAID")
  transactionId String?         @map("transaction_id")
  transaction   Transaction?    @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([policyId])
  @@map("insurance_premiums")
}

model InsuranceClaim {
  id            String          @id @default(uuid())
  claimNumber   String          @unique @map("claim_number")
  policyId      String          @map("policy_id")
  policy        InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  memberId      String          @map("member_id")
  member        Member          @relation(fields: [memberId], references: [id])
  amount        Decimal         @db.Decimal(19, 4)
  description   String?
  claimDate     DateTime        @map("claim_date")
  status        String          @default("PENDING")
  approvedAmount Decimal?       @db.Decimal(19, 4) @map("approved_amount")
  approvedBy    String?         @map("approved_by")
  approvedAt    DateTime?       @map("approved_at")
  payoutDate    DateTime?       @map("payout_date")
  transactionId String?         @map("transaction_id")
  transaction   Transaction?    @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([policyId])
  @@index([memberId])
  @@index([status])
  @@map("insurance_claims")
}

// ============================================
// COMPLIANCE & RISK
// ============================================

model ComplianceRecord {
  id             String       @id @default(uuid())
  recordNumber   String       @unique @map("record_number")
  type           String       // AML, KYC, REGULATORY, TAX, AUDIT
  description    String?
  status         String       @default("PENDING")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String?      @map("member_id")
  member         Member?      @relation("ComplianceMember", fields: [memberId], references: [id])
  createdById    String       @map("created_by_id")
  createdBy      User         @relation("ComplianceCreatedBy", fields: [createdById], references: [id])
  reviewedById   String?      @map("reviewed_by_id")
  reviewedAt     DateTime?    @map("reviewed_at")
  findings       Json?
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@map("compliance_records")
}

model RiskAssessment {
  id             String       @id @default(uuid())
  assessmentNumber String     @unique @map("assessment_number")
  type           String       // CREDIT, OPERATIONAL, MARKET, LIQUIDITY, COMPLIANCE
  riskLevel      RiskLevel    @default(LOW)
  score          Decimal      @db.Decimal(5, 2)
  description    String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String?      @map("member_id")
  member         Member?      @relation("RiskAssessmentMember", fields: [memberId], references: [id])
  assessedById   String       @map("assessed_by_id")
  assessedBy     User         @relation("RiskAssessedBy", fields: [assessedById], references: [id])
  mitigationPlan String?      @map("mitigation_plan")
  status         String       @default("OPEN")
  reviewDate     DateTime?    @map("review_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([memberId])
  @@index([riskLevel])
  @@map("risk_assessments")
}

model FraudAlert {
  id             String       @id @default(uuid())
  alertNumber    String       @unique @map("alert_number")
  type           String       // DUPLICATE_MEMBER, DUPLICATE_PAYMENT, UNUSUAL_TRANSACTION, ORPHAN_RECORD, INCONSISTENCY
  severity       RiskLevel    @default(MEDIUM)
  description    String
  status         String       @default("OPEN")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String?      @map("member_id")
  member         Member?      @relation("FraudAlertMember", fields: [memberId], references: [id])
  createdById    String       @map("created_by_id")
  createdBy      User         @relation("FraudAlertCreatedBy", fields: [createdById], references: [id])
  resolvedById   String?      @map("resolved_by_id")
  resolvedAt     DateTime?    @map("resolved_at")
  resolution     String?
  evidence       Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@index([severity])
  @@map("fraud_alerts")
}

// ============================================
// INTEGRATIONS & API
// ============================================

model Integration {
  id             String       @id @default(uuid())
  name           String
  provider       String       // MPESA, BANK, STRIPE, PAYPAL, etc.
  type           String       // PAYMENT, SMS, EMAIL, BANKING, CRM
  config         Json?
  isActive       Boolean      @default(true) @map("is_active")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastSyncAt     DateTime?    @map("last_sync_at")
  lastSyncStatus String?      @map("last_sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([provider])
  @@map("integrations")
}

model ApiKey {
  id             String       @id @default(uuid())
  name           String
  key            String       @unique
  secret         String
  permissions    String[]     // Comma-separated permissions
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")
  lastUsedAt     DateTime?    @map("last_used_at")
  expiresAt      DateTime?    @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("api_keys")
}

// ============================================
// SYSTEM MONITORING & BACKUP
// ============================================

model SystemHealthLog {
  id             String       @id @default(uuid())
  component      String       // API, DATABASE, REDIS, QUEUE, EMAIL, SMS
  status         String       // HEALTHY, DEGRADED, DOWN
  responseTime   Int?         @map("response_time") // ms
  errorRate      Decimal?     @db.Decimal(5, 2) @map("error_rate")
  details        Json?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([component])
  @@index([status])
  @@index([createdAt])
  @@map("system_health_logs")
}

model BackupConfig {
  id             String       @id @default(uuid())
  name           String
  type           String       // FULL, INCREMENTAL, DIFFERENTIAL
  frequency      Frequency    @default(DAILY)
  retentionDays  Int          @default(30) @map("retention_days")
  storagePath    String       @map("storage_path")
  isActive       Boolean      @default(true) @map("is_active")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastBackupAt   DateTime?    @map("last_backup_at")

  logs           BackupLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("backup_configs")
}

model BackupLog {
  id             String       @id @default(uuid())
  backupConfigId String       @map("backup_config_id")
  backupConfig   BackupConfig @relation(fields: [backupConfigId], references: [id], onDelete: Cascade)
  type           String
  size           Int?         // bytes
  status         String       // SUCCESS, FAILED, IN_PROGRESS
  startedAt      DateTime     @map("started_at")
  completedAt    DateTime?    @map("completed_at")
  filePath       String?      @map("file_path")
  errorMessage   String?      @map("error_message")
  initiatedById  String?      @map("initiated_by_id")
  initiatedBy    User?        @relation("BackupInitiatedBy", fields: [initiatedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([backupConfigId])
  @@index([status])
  @@map("backup_logs")
}

// ============================================
// TRUST ENGINE - HASH CHAIN
// ============================================

model TrustHash {
  id           String   @id @default(uuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  hash         String
  previousHash String?  @map("previous_hash")
  chainIndex   Int      @map("chain_index")
  metadata     Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([entityType, entityId])
  @@index([entityType, chainIndex])
  @@map("trust_hashes")
}