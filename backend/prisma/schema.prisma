// ============================================
// LOANS
// ============================================

model LoanProduct {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  minAmount      Decimal      @db.Decimal(19, 4) @map("min_amount")
  maxAmount      Decimal      @db.Decimal(19, 4) @map("max_amount")
  minTenure      Int          @map("min_tenure")
  maxTenure      Int          @map("max_tenure")
  interestRate   Decimal      @db.Decimal(5, 2) @map("interest_rate")
  interestType   String       @default("FLAT") @map("interest_type")
  processingFee  Decimal      @default(0) @db.Decimal(5, 2) @map("processing_fee")
  latePaymentFee Decimal      @default(0) @db.Decimal(5, 2) @map("late_payment_fee")
  requiresGuarantor Boolean  @default(false) @map("requires_guarantor")
  maxGuarantors  Int          @default(2) @map("max_guarantors")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  loans          Loan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("loan_products")
}

model Loan {
  id              String       @id @default(uuid())
  loanNumber      String       @unique @map("loan_number")
  memberId        String       @map("member_id")
  member          Member       @relation(fields: [memberId], references: [id])
  productId       String       @map("product_id")
  product         LoanProduct  @relation(fields: [productId], references: [id])
  principal       Decimal      @db.Decimal(19, 4)
  interestRate    Decimal      @db.Decimal(5, 2) @map("interest_rate")
  interestType    String       @map("interest_type")
  tenure          Int
  totalInterest   Decimal      @db.Decimal(19, 4) @map("total_interest")
  totalAmount     Decimal      @db.Decimal(19, 4) @map("total_amount")
  monthlyPayment  Decimal      @db.Decimal(19, 4) @map("monthly_payment")
  amountDisbursed Decimal      @default(0) @db.Decimal(19, 4) @map("amount_disbursed")
  amountPaid      Decimal      @default(0) @db.Decimal(19, 4) @map("amount_paid")
  balance         Decimal      @db.Decimal(19, 4)
  status          LoanStatus   @default(PENDING)
  applicationDate DateTime     @default(now()) @map("application_date")
  approvalDate    DateTime?    @map("approval_date")
  disbursementDate DateTime?   @map("disbursement_date")
  maturityDate    DateTime?    @map("maturity_date")
  purpose         String?
  notes           String?
  deletedAt       DateTime?    @map("deleted_at")

  repayments      LoanRepayment[]
  guarantors      LoanGuarantor[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([productId])
  @@index([status])
  @@index([applicationDate])
  @@index([maturityDate])
  @@index([deletedAt])
  @@map("loans")
}

model LoanRepayment {
  id            String     @id @default(uuid())
  loanId        String     @map("loan_id")
  loan          Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount        Decimal    @db.Decimal(19, 4)
  principal     Decimal    @db.Decimal(19, 4)
  interest      Decimal    @db.Decimal(19, 4)
  penalty       Decimal    @default(0) @db.Decimal(19, 4)
  balance       Decimal    @db.Decimal(19, 4)
  dueDate       DateTime   @map("due_date")
  paidDate      DateTime?  @map("paid_date")
  status        String     @default("PENDING")
  reference     String?
  notes         String?
  transactionId String?    @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([loanId])
  @@index([status])
  @@index([dueDate])
  @@map("loan_repayments")
}

model LoanGuarantor {
  id       String    @id @default(uuid())
  loanId   String    @map("loan_id")
  loan     Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId String    @map("member_id")
  member   Member    @relation("Guarantor", fields: [memberId], references: [id])
  amount   Decimal   @db.Decimal(19, 4)
  status   String    @default("PENDING")
  approvedAt DateTime? @map("approved_at")
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loanId, memberId])
  @@index([memberId])
  @@map("loan_guarantors")
}

