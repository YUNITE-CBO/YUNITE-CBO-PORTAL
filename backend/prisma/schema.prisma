// YUNITE Banking System - Complete Database Schema
// Core Banking-inspired Enterprise Operating System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  CONTINGENT
}

enum AccountClass {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  SHAREHOLDER_EQUITY
  RETAINED_EARNINGS
  OPERATING_INCOME
  OTHER_INCOME
  OPERATING_EXPENSE
  ADMIN_EXPENSE
  TAX_EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  DORMANT
  BLACKLISTED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  ACTIVE
  COMPLETED
  DEFAULTED
  WRITTEN_OFF
  RESTRUCTURED
  CANCELLED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  PARTIALLY_APPROVED
  RETURNED_FOR_REVISION
}

enum MeetingType {
  ANNUAL
  QUARTERLY
  MONTHLY
  SPECIAL
  EMERGENCY
  BOARD
  COMMITTEE
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  CLOSED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrganizationType {
  CBO
  SACCO
  NGO
  COOPERATIVE
  ASSOCIATION
  CHAMA
  SELF_HELP_GROUP
  INVESTMENT_CLUB
  FAITH_ORGANIZATION
  MULTI_BRANCH
  MICROFINANCE
  VILLAGE_BANK
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ALERT
  REMINDER
}

enum PaymentMethod {
  CASH
  MPESA
  BANK_TRANSFER
  CHEQUE
  CARD
  QR
  MOBILE_MONEY
  ONLINE
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_TIME
}

// ============================================
// ORGANIZATION & BRANCH MANAGEMENT
// ============================================

model Organization {
  id                 String           @id @default(uuid())
  name               String
  registrationNumber String?          @unique @map("registration_number")
  type               OrganizationType @default(CBO)
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String?          @default("Kenya")
  logoUrl            String?          @map("logo_url")
  website            String?
  description        String?
  settings           Json?            @default("{}")
  isActive           Boolean          @default(true) @map("is_active")
  deletedAt          DateTime?        @map("deleted_at")

  // Relations
  users              User[]
  branches           Branch[]
  members            Member[]
  memberGroups       MemberGroup[]
  accounts           Account[]
  loanProducts       LoanProduct[]
  savingsProducts    SavingsProduct[]
  shareProducts      ShareProduct[]
  contributionCampaigns ContributionCampaign[]
  welfareSchemes     WelfareScheme[]
  meetings           Meeting[]
  polls              Poll[]
  projects           Project[]
  unityFund          UnityFund?
  unityFundAllocations UnityFundAllocation[]
  settings           Setting[]
  fineRules          FineRule[]
  events             Event[]
  tasks              Task[]
  contracts          Contract[]
  suppliers          Supplier[]
  vendors            Vendor[]
  customers          Customer[]
  budgetPeriods      BudgetPeriod[]
  procurementRequests ProcurementRequest[]
  assets             Asset[]
  inventoryItems     InventoryItem[]
  payrollRuns        PayrollRun[]
  departments        Department[]
  beneficiaries      Beneficiary[]
  insuranceSchemes   InsuranceScheme[]
  helpDeskTickets    HelpDeskTicket[]
  integrations       Integration[]
  apiKeys            ApiKey[]
  backupConfigs      BackupConfig[]
  complianceRecords  ComplianceRecord[]
  riskAssessments    RiskAssessment[]
  fraudAlerts        FraudAlert[]
  systemHealthLogs   SystemHealthLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address        String?
  phone          String?
  email          String?
  isActive       Boolean      @default(true) @map("is_active")
  deletedAt      DateTime?    @map("deleted_at")

  members        Member[]
  accounts       Account[]
  departments    Department[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @map("branch_id")
  branch         Branch?      @relation(fields: [branchId], references: [id])
  isActive       Boolean      @default(true) @map("is_active")

  employees      Employee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([branchId])
  @@map("departments")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  password        String
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  phone           String?
  status          MemberStatus @default(ACTIVE)
  roleId          String       @map("role_id")
  role            Role         @relation(fields: [roleId], references: [id])
  organizationId  String?      @map("organization_id")
  organization    Organization? @relation(fields: [organizationId], references: [id])
  lastLoginAt     DateTime?    @map("last_login_at")
  refreshToken    String?      @map("refresh_token")
  emailVerifiedAt DateTime?    @map("email_verified_at")
  mfaEnabled      Boolean      @default(false) @map("mfa_enabled")
  mfaSecret       String?      @map("mfa_secret")
  deletedAt       DateTime?    @map("deleted_at")

  sessions        UserSession[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  createdMembers  Member[]     @relation("CreatedBy")
  updatedMembers  Member[]     @relation("UpdatedBy")
  createdSettings Setting[]    @relation("SettingCreatedBy")
  updatedSettings Setting[]    @relation("SettingUpdatedBy")
  approvals       Approval[]
  workflowActions WorkflowAction[]
  documents       Document[]   @relation("DocumentUploadedBy")
  messages        Message[]    @relation("MessageSender")
  receivedMessages Message[]   @relation("MessageRecipient")
  helpDeskTickets HelpDeskTicket[] @relation("TicketCreatedBy")
  helpDeskAssignments HelpDeskTicket[] @relation("TicketAssignedTo")
  tasks           Task[]       @relation("TaskAssignedTo")
  createdTasks    Task[]       @relation("TaskCreatedBy")
  events          Event[]      @relation("EventCreatedBy")
  contracts       Contract[]   @relation("ContractCreatedBy")
  payrollRuns     PayrollRun[] @relation("PayrollProcessedBy")
  backupLogs      BackupLog[]  @relation("BackupInitiatedBy")
  complianceRecords ComplianceRecord[] @relation("ComplianceCreatedBy")
  riskAssessments RiskAssessment[] @relation("RiskAssessedBy")
  fraudAlerts     FraudAlert[] @relation("FraudAlertCreatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  permissions Permission[]
  users       User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  action   String // create, read, update, delete, approve, export
  resource String // members, loans, savings, shares, etc.
  roleId   String @map("role_id")
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action, resource])
  @@map("permissions")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  deviceInfo   Json?    @map("device_info")
  location     String?
  expiresAt    DateTime @map("expires_at")
  isActive     Boolean  @default(true) @map("is_active")
  lastActivity DateTime? @map("last_activity")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshToken])
  @@map("user_sessions")
}

// ============================================
// MEMBERS
// ============================================

model Member {
  id             String       @id @default(uuid())
  memberNumber   String       @unique @map("member_number")
  accountNumber  String       @unique @map("account_number")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @map("branch_id")
  branch         Branch?      @relation(fields: [branchId], references: [id])

  // Personal Information
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  dateOfBirth    DateTime?    @map("date_of_birth")
  gender         Gender?
  idNumber       String?      @map("id_number")
  nationality    String?      @default("Kenyan")
  occupation     String?
  employer       String?

  // Address
  address        String?
  city           String?
  county         String?
  postalCode     String?      @map("postal_code")
  country        String?      @default("Kenya")

  // Photo & Documents
  photoUrl       String?      @map("photo_url")
  signature      String?

  // Status
  status         MemberStatus @default(PENDING)
  statusReason   String?      @map("status_reason")
  registrationDate DateTime  @default(now()) @map("registration_date")
  deletedAt      DateTime?    @map("deleted_at")

  // Financial Scores
  creditScore    Decimal      @default(0) @db.Decimal(5, 2) @map("credit_score")
  riskScore      Decimal      @default(0) @db.Decimal(5, 2) @map("risk_score")
  aiScore        Decimal      @default(0) @db.Decimal(5, 2) @map("ai_score")

  // Relations
  createdById    String?      @map("created_by_id")
  createdBy      User?        @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById    String?      @map("updated_by_id")
  updatedBy      User?        @relation("UpdatedBy", fields: [updatedById], references: [id])

  memberGroupMemberships MemberGroupMembership[]
  savingsAccounts    SavingsAccount[]
  shareAccounts      ShareAccount[]
  loans              Loan[]
  guarantors         LoanGuarantor[] @relation("Guarantor")
  contributions      MemberContribution[]
  welfareContributions WelfareContribution[]
  welfarePayouts     WelfarePayout[]
  fines              MemberFine[]
  penalties          MemberPenalty[]
  attendanceRecords  MeetingAttendee[]
  votes              PollVote[]
  documents          Document[]
  projectInvestments ProjectInvestment[]
  projectIncome      ProjectIncome[]
  projectExpenses    ProjectExpense[]
  profitDistributions ProfitDistribution[]
  tableBankingCycles TableBankingCycle[]
  emergencyFundContributions EmergencyFundContribution[]
  emergencyFundWithdrawals EmergencyFundWithdrawal[]
  insurancePolicies  InsurancePolicy[]
  insuranceClaims    InsuranceClaim[]
  insurancePremiums  InsurancePremium[]
  beneficiaryRecords Beneficiary[] @relation("BeneficiaryMember")
  payrollItems       PayrollItem[]
  employeeRecord     Employee?
  messages           Message[] @relation("MessageMember")
  helpDeskTickets    HelpDeskTicket[] @relation("TicketMember")
  complianceRecords  ComplianceRecord[] @relation("ComplianceMember")
  riskAssessments    RiskAssessment[] @relation("RiskAssessmentMember")
  fraudAlerts        FraudAlert[] @relation("FraudAlertMember")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([idNumber])
  @@map("members")
}

model MemberGroup {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members        MemberGroupMembership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, organizationId])
  @@map("member_groups")
}

model MemberGroupMembership {
  id         String      @id @default(uuid())
  memberId   String      @map("member_id")
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  groupId    String      @map("group_id")
  group      MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt   DateTime    @default(now()) @map("joined_at")
  isActive   Boolean     @default(true) @map("is_active")

  @@unique([memberId, groupId])
  @@map("member_group_memberships")
}

// ============================================
// ACCOUNTING - CHART OF ACCOUNTS
// ============================================

model Account {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  description    String?
  type           AccountType
  class          AccountClass
  parentId       String?      @map("parent_id")
  parent         Account?     @relation("AccountTree", fields: [parentId], references: [id])
  children       Account[]    @relation("AccountTree")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @map("branch_id")
  branch         Branch?      @relation(fields: [branchId], references: [id])
  currency       String       @default("KES")
  isActive       Boolean      @default(true) @map("is_active")
  isSystem       Boolean      @default(false) @map("is_system")
  isControl      Boolean      @default(false) @map("is_control")
  deletedAt      DateTime?    @map("deleted_at")

  journalLines   JournalEntryLine[]
  budgetLines    BudgetLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([organizationId])
  @@index([branchId])
  @@index([type, class])
  @@map("accounts")
}

// ============================================
// FINANCIAL LEDGER - DOUBLE ENTRY
// ============================================

model JournalEntry {
  id             String            @id @default(uuid())
  entryNumber    String            @unique @map("entry_number")
  date           DateTime          @default(now())
  description    String
  reference      String?           // External reference
  referenceType  String?           @map("reference_type") // invoice, receipt, etc.
  totalDebit     Decimal           @default(0) @db.Decimal(19, 4) @map("total_debit")
  totalCredit    Decimal           @default(0) @db.Decimal(19, 4) @map("total_credit")
  isBalanced     Boolean           @default(false) @map("is_balanced")
  isReversal     Boolean           @default(false) @map("is_reversal")
  reversedById   String?           @map("reversed_by_id")
  reversedAt     DateTime?         @map("reversed_at")
  status         TransactionStatus @default(COMPLETED)
  organizationId String            @map("organization_id")
  branchId       String?           @map("branch_id")

  journalLines   JournalEntryLine[]
  transactions   Transaction[]

  createdById    String            @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([entryNumber])
  @@index([date])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String       @id @default(uuid())
  journalEntryId  String       @map("journal_entry_id")
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId       String       @map("account_id")
  account         Account      @relation(fields: [accountId], references: [id])
  debit           Decimal      @default(0) @db.Decimal(19, 4)
  credit          Decimal      @default(0) @db.Decimal(19, 4)
  description     String?
  reference       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([journalEntryId])
  @@map("journal_entry_lines")
}

// ============================================
// TRANSACTIONS - CENTRAL TRANSACTION ENGINE
// ============================================

model Transaction {
  id                String            @id @default(uuid())
  transactionNumber String            @unique @map("transaction_number")
  type              String            // SAVINGS_DEPOSIT, LOAN_DISBURSEMENT, etc.
  amount            Decimal           @db.Decimal(19, 4)
  balanceBefore     Decimal?          @db.Decimal(19, 4) @map("balance_before")
  balanceAfter      Decimal?          @db.Decimal(19, 4) @map("balance_after")
  description       String?
  reference         String?
  referenceNumber   String?           @map("reference_number")
  status            TransactionStatus @default(PENDING)
  paymentMethod     PaymentMethod?    @map("payment_method")
  paymentReference  String?           @map("payment_reference")
  journalEntryId    String?           @map("journal_entry_id")
  journalEntry      JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  organizationId    String            @map("organization_id")
  branchId          String?           @map("branch_id")
  memberId          String?           @map("member_id")
  member            Member?           @relation(fields: [memberId], references: [id])

  // Polymorphic reference
  entityType        String?           @map("entity_type")
  entityId          String?           @map("entity_id")

  // Approval
  approvalStatus    ApprovalStatus    @default(APPROVED) @map("approval_status")
  approvedById      String?           @map("approved_by_id")
  approvedAt        DateTime?         @map("approved_at")

  // Reversal
  reversedById      String?           @map("reversed_by_id")
  reversedAt        DateTime?         @map("reversed_at")
  reversalReason    String?           @map("reversal_reason")

  // Soft delete
  deletedAt         DateTime?         @map("deleted_at")

  // Relations
  createdById       String            @map("created_by_id")
  savingsTransactions   SavingsTransaction[]
  shareTransactions     ShareTransaction[]
  loanRepayments        LoanRepayment[]
  memberContributions   MemberContribution[]
  welfareContributions  WelfareContribution[]
  memberFines           MemberFine[]
  memberPenalties       MemberPenalty[]
  projectInvestments    ProjectInvestment[]
  projectIncome         ProjectIncome[]
  projectExpenses       ProjectExpense[]
  profitDistributions   ProfitDistribution[]
  unityFundTransactions UnityFundTransaction[]
  unityFundWithdrawals  UnityFundWithdrawal[]
  tableBankingContributions TableBankingContribution[]
  emergencyFundContributions EmergencyFundContribution[]
  emergencyFundWithdrawals EmergencyFundWithdrawal[]
  insurancePremiums    InsurancePremium[]
  insuranceClaims      InsuranceClaim[]
  payrollItems         PayrollItem[]
  budgetTransactions   BudgetTransaction[]
  procurementPayments  ProcurementPayment[]
  assetTransactions    AssetTransaction[]
  inventoryTransactions InventoryTransaction[]
  contractPayments     ContractPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([transactionNumber])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([organizationId])
  @@index([memberId])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("transactions")
}

// ============================================
// SAVINGS
// ============================================

model SavingsProduct {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  interestRate   Decimal      @db.Decimal(5, 2) @map("interest_rate")
  interestType   String       @default("MONTHLY") @map("interest_type")
  minBalance     Decimal      @default(0) @db.Decimal(19, 4) @map("min_balance")
  maxBalance     Decimal?     @db.Decimal(19, 4) @map("max_balance")
  withdrawalLimit Decimal?    @db.Decimal(19, 4) @map("withdrawal_limit")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  accounts       SavingsAccount[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("savings_products")
}

model SavingsAccount {
  id             String         @id @default(uuid())
  accountNumber  String         @unique @map("account_number")
  memberId       String         @map("member_id")
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  productId      String         @map("product_id")
  product        SavingsProduct @relation(fields: [productId], references: [id])
  balance        Decimal        @default(0) @db.Decimal(19, 4)
  availableBalance Decimal      @default(0) @db.Decimal(19, 4) @map("available_balance")
  lienAmount     Decimal        @default(0) @db.Decimal(19, 4) @map("lien_amount")
  status         MemberStatus   @default(ACTIVE)
  interestAccrued Decimal       @default(0) @db.Decimal(19, 4) @map("interest_accrued")
  lastInterestCalc DateTime?    @map("last_interest_calc")
  openedDate     DateTime       @default(now()) @map("opened_date")
  closedDate     DateTime?      @map("closed_date")

  transactions   SavingsTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([productId])
  @@index([status])
  @@map("savings_accounts")
}

model SavingsTransaction {
  id             String         @id @default(uuid())
  reference      String         @unique
  accountId      String         @map("account_id")
  account        SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           String         // DEPOSIT, WITHDRAWAL, INTEREST, FEE, TRANSFER
  amount         Decimal        @db.Decimal(19, 4)
  balanceBefore  Decimal        @db.Decimal(19, 4) @map("balance_before")
  balanceAfter   Decimal        @db.Decimal(19, 4) @map("balance_after")
  description    String?
  transactionId  String?        @map("transaction_id")
  transaction    Transaction?   @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([type])
  @@index([createdAt])
  @@map("savings_transactions")
}

// ============================================
// SHARES
// ============================================

model ShareProduct {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  nominalValue   Decimal      @db.Decimal(19, 4) @map("nominal_value")
  minShares      Int?         @default(1) @map("min_shares")
  maxShares      Int?         @map("max_shares")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true) @map("is_active")

  accounts       ShareAccount[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("share_products")
}

model ShareAccount {
  id             String         @id @default(uuid())
  accountNumber  String         @unique @map("account_number")
  memberId       String         @map("member_id")
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  productId      String         @map("product_id")
  product        ShareProduct   @relation(fields: [productId], references: [id])
  shares         Int            @default(0)
  totalValue     Decimal        @default(0) @db.Decimal(19, 4) @map("total_value")
  status         MemberStatus   @default(ACTIVE)
  openedDate     DateTime       @default(now()) @map("opened_date")

  transactions   ShareTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([productId])
  @@map("share_accounts")
}

model ShareTransaction {
  id             String         @id @default(uuid())
  reference      String         @unique
  accountId      String         @map("account_id")
  account        ShareAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           String         // PURCHASE, REDEMPTION, TRANSFER, DIVIDEND
